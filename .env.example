# --- App ---
NODE_ENV=development
PORT=3000

# --- Database ---
# Point this at whatever Postgres you're using — a local install, or a live/hosted
# instance (Supabase, Neon, RDS, Railway, etc). Prisma only needs this one URL.
#
# Local Postgres example (adjust user/password/db to match your local setup):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nest_prisma_db?schema=public"
#
# Live/hosted example (most providers give you this URL directly, often with ?sslmode=require):
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nest_prisma_db?schema=public"

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-this-too-a-different-long-random-string
JWT_REFRESH_TTL=7d
